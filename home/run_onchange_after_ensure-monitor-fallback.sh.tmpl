#!/usr/bin/env bash
# machine: {{ .machine }} role={{ .role }}
# monitors-*.conf chỉ được source từ hyprland.conf (AriadnevShell). Máy Noctalia
# khai monitor bằng hl.monitor() trong hyprland.lua nên không cần fallback này.
{{- if and (eq .role "desktop") (eq .shell "ariadnev") }}
set -euo pipefail

conf="$HOME/.config/hypr/monitors-{{ .machine }}.conf"
if [[ ! -f "$conf" ]]; then
  mkdir -p "$(dirname "$conf")"
  printf '# Auto-generated fallback monitor config\n# Replace with your actual monitor setup\nmonitor = , preferred, auto, 1\n' > "$conf"
  echo "Created fallback monitor config at $conf"
fi
{{- else }}
: # không phải máy AriadnevShell — bỏ qua
{{- end }}
