[Hotkey]
# Enumerate when press trigger key repeatedly
EnumerateWithTriggerKeys=True
# Enumerate Input Method Group forward
EnumerateGroupForwardKeys=
# Enumerate Input Method Group backward
EnumerateGroupBackwardKeys=
# Skip first input method while enumerating
EnumerateSkipFirst=False

[Hotkey/TriggerKeys]
0=Alt+space

# Tắt Shift_L đơn lẻ toggle IME: Hyprland grab phím trong các bind SUPER+SHIFT+*,
# fcitx5 chỉ thấy Shift press/release nên tưởng là AltTrigger -> đổi ngôn ngữ nhầm.
[Hotkey/AltTriggerKeys]

[Hotkey/EnumerateForwardKeys]
0=Control+Shift_L

[Hotkey/EnumerateBackwardKeys]
0=Control+Shift_R

[Hotkey/PrevPage]
0=Up

[Hotkey/NextPage]
0=Down

[Behavior]
# Active By Default
ActiveByDefault=False
# Share Input State: No/All/Program
# Program = nhớ IM theo từng chương trình (per-app). Alt+space trong Chrome sẽ
# không đụng tới trạng thái bàn phím ở Ghostty. Đổi focus giữa các app có thể
# trông như "tự đổi ngôn ngữ" — nhưng đó chính là mục đích.
ShareInputState=Program
# Show preedit in application
PreeditEnabledByDefault=True
# Show Input Method Information when switch input method
# Tắt: OSD "keyboard_layout" của Noctalia đã hiện tên IM ở top_center rồi, cái
# popup "en"/"vi" nổi trên caret của fcitx5 chỉ là báo trùng.
ShowInputMethodInformation=False
ShowInputMethodInformationWhenFocusIn=False
# Default page size
DefaultPageSize=5
