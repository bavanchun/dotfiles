{{- if stat "/usr/share/omarchy/version" -}}
{{-   fail "This host runs Omarchy — use bavanchun/dotconfig-omarchy instead. See README." -}}
{{- end -}}

[data]
  machine = {{ .chezmoi.hostname | quote }}
  terminal = {{ promptChoice "terminal" (list "wezterm" "kitty" "alacritty" "none") "wezterm" | quote }}

[git]
  autoCommit = false
  autoPush = false

[sourceVCS]
  url = "git@github.com:bavanchun/dotconfig-term.git"