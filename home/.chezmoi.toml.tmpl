{{- /* Omarchy tự quản lý config của nó và có repo riêng (dotconfig-omarchy). */ -}}
{{- if stat "/usr/share/omarchy/version" -}}
{{-   fail "Máy này chạy Omarchy — dùng bavanchun/dotconfig-omarchy. Xem README." -}}
{{- end -}}

{{- /* Đoán vai trò làm giá trị mặc định cho prompt. */ -}}
{{- $guess := "cli" -}}
{{- if or (stat "/usr/bin/Hyprland") (stat "/usr/bin/hyprland") (env "WAYLAND_DISPLAY") -}}
{{-   $guess = "desktop" -}}
{{- end -}}

{{- /* promptChoiceOnce chứ không phải promptChoice: chỉ hỏi lần đầu, các lần
       `chezmoi init` sau sẽ dùng lại giá trị đã lưu trong config. */ -}}
{{- /* Chuỗi prompt phải NGẮN và không chứa dấu phẩy hay "=", vì cờ
       --promptChoice khớp theo chính chuỗi prompt chứ không phải tên biến:
         chezmoi init --promptChoice "Vai trò máy=cli" ...
       Hoặc dùng --promptDefaults để lấy giá trị mặc định (role tự đoán). */ -}}
{{- $role := promptChoiceOnce . "role" "Vai trò máy" (list "desktop" "cli") $guess -}}
{{- $terminal := promptChoiceOnce . "terminal" "Terminal chính" (list "wezterm" "kitty" "alacritty" "ghostty" "none") "wezterm" -}}

{{- /* Tầng desktop có HAI biến thể shell không đội trời chung: AriadnevShell dùng
       hyprland.conf + quickshell, Noctalia dùng hyprland.lua + binary riêng. Cả hai
       cùng giữ bus org.freedesktop.Notifications nên không thể cài song song.
       Biến này vô nghĩa khi role=cli, nhưng vẫn hỏi để máy nâng cấp lên desktop
       sau này không phải sửa tay chezmoi.toml. */ -}}
{{- $shellGuess := "ariadnev" -}}
{{- if stat "/usr/bin/noctalia" -}}
{{-   $shellGuess = "noctalia" -}}
{{- end -}}
{{- $shell := promptChoiceOnce . "shell" "Shell desktop" (list "ariadnev" "noctalia") $shellGuess -}}

[data]
  machine  = {{ .chezmoi.hostname | quote }}
  role     = {{ $role | quote }}
  terminal = {{ $terminal | quote }}
  shell    = {{ $shell | quote }}

[git]
  autoCommit = false
  autoPush = false

[sourceVCS]
  url = "git@github.com:bavanchun/dotfiles.git"
