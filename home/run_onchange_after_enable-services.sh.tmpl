#!/usr/bin/env bash
# services version: 5 (role={{ .role }})
# Toàn bộ service ở đây là của máy Arch desktop -> guard, nếu không thì trên
# Ubuntu/macOS `sudo systemctl enable sddm` sẽ làm hỏng cả lượt apply.
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") (eq .role "desktop") }}
set -euo pipefail

# ── System services ───────────────────────────────────────────────────────────
system_services=(
  NetworkManager.service
  bluetooth.service
  power-profiles-daemon.service
)

for svc in "${system_services[@]}"; do
  if systemctl list-unit-files "$svc" &>/dev/null; then
    sudo systemctl enable --now "$svc" || echo "Warning: failed to enable $svc"
  fi
done

# ── Display manager: greetd (AriadnevGreeter) ưu tiên, sddm là fallback ──────
# `advs-greeter install` đã lo enable greetd + disable sddm; ở đây chỉ đảm bảo
# không bao giờ bật CẢ HAI. sddm vẫn được cài để còn đường lui.
if systemctl list-unit-files greetd.service &>/dev/null \
   && grep -q "advs-greeter" /etc/greetd/config.toml 2>/dev/null; then
  sudo systemctl enable greetd || echo "Warning: failed to enable greetd"
elif systemctl list-unit-files sddm.service &>/dev/null; then
  sudo systemctl enable sddm || echo "Warning: failed to enable sddm"
fi

# ── Snapshot / rollback (snapper + grub-btrfs) ────────────────────────────────
# Việc dựng subvolume @snapshots và tạo config snapper nằm ở README (mục Rollback)
# vì nó đụng tới fstab; ở đây chỉ bật timer khi config đã tồn tại.
if [ -d /etc/snapper/configs ] && [ -e /etc/snapper/configs/root ]; then
  for svc in snapper-timeline.timer snapper-cleanup.timer grub-btrfsd.service; do
    if systemctl list-unit-files "$svc" &>/dev/null; then
      sudo systemctl enable --now "$svc" || echo "Warning: failed to enable $svc"
    fi
  done
fi

# ── User services ─────────────────────────────────────────────────────────────
# AriadnevShell chạy bằng systemd chứ không phải exec-once trong hyprland.conf:
# unit có Restart=on-failure nên bar tự dựng lại khi quickshell crash.
# Chỉ được bật MỘT trong advs.service / dms.service, vì cả hai cùng giữ
# BusName=org.freedesktop.Notifications.
if systemctl --user list-unit-files advs.service &>/dev/null; then
  systemctl --user disable --now dms.service 2>/dev/null || true
  systemctl --user enable advs.service || echo "Warning: failed to enable advs.service"
elif systemctl --user list-unit-files dms.service &>/dev/null; then
  # Chưa cài AriadnevShell thì tạm dùng DMS upstream.
  systemctl --user enable dms.service || echo "Warning: failed to enable dms.service"
fi

# dunst cũng giữ bus org.freedesktop.Notifications và làm systemd từ chối
# unit của shell ("Two services allocated for the same bus name"). Shell đã lo
# notification nên mask hẳn dunst.
if systemctl --user list-unit-files dunst.service &>/dev/null; then
  systemctl --user mask dunst.service || echo "Warning: failed to mask dunst.service"
fi

echo "Services enabled. (zsh default shell do run_onchange_after_chsh-zsh.sh lo)"
{{- else }}
: # không phải Arch desktop — bỏ qua
{{- end }}
