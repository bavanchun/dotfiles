# LƯU Ý QUAN TRỌNG: .chezmoiignore khớp theo đường dẫn ĐÍCH (".config/...")
# chứ KHÔNG phải đường dẫn nguồn ("dot_config/..."). Repo dotconfig-arch cũ ghi
# nhầm kiểu nguồn nên toàn bộ dòng ignore ở đó vô tác dụng.
# Kiểm chứng: chezmoi managed --source <src> --destination <dest>

# ── Thư mục phụ trợ: không đổ vào $HOME ──────────────────────────────────────
# (README.md và plans/ nằm NGOÀI source dir nhờ .chezmoiroot=home, nên không
#  cần ignore — chezmoi không nhìn thấy chúng.)
.claude/

# yazi/ là NGUỒN cho symlink ~/.config/yazi (xem dot_config/symlink_yazi.tmpl),
# nên phải nằm trong source dir — nhưng không được copy thẳng thành ~/yazi.
yazi
yazi/**

# ── Backup / state ───────────────────────────────────────────────────────────
**/*.bak
**/*.bak2
**/*.bak3
**/*.bak_*
**/*.bak-*
**/*.old
**/*.pre
**/*.disabled
**/*.rejected-*

# ── File do máy tự sinh, không portable giữa các máy ──────────────────────────
# matugen/DMS sinh lại từ wallpaper mỗi lần apply theme:
.config/hypr/dms
.config/hypr/dms/**
.config/gtk-3.0/dank-colors.css
.config/gtk-4.0/dank-colors.css
.config/qt6ct/colors
.config/qt6ct/colors/**
.config/dgop/colors.json
# nwg-displays sinh:
.config/hypr/monitors.conf
# fcitx5: track config + profile + conf/bamboo.conf (kiểu gõ Telex, spell check);
# phần còn lại trong conf/ là cache runtime do fcitx5 tự sinh.
.config/fcitx5/conf/*
!.config/fcitx5/conf/bamboo.conf

{{/* ── Tầng desktop: máy role=cli hoặc không phải Linux thì bỏ qua hẳn ───── */}}
{{- if or (ne .role "desktop") (ne .chezmoi.os "linux") }}
.config/hypr
.config/hypr/**
.config/xkb
.config/xkb/**
.config/fcitx5
.config/fcitx5/**
.config/DankMaterialShell
.config/DankMaterialShell/**
.config/noctalia
.config/noctalia/**
{{- end }}

{{/* ── Biến thể shell: hai bộ config Hyprland loại trừ nhau ─────────────────
     AriadnevShell đọc hyprland.conf, Noctalia đọc hyprland.lua. Để cả hai rơi
     vào ~/.config/hypr thì Hyprland có hai file config cạnh nhau — mơ hồ và dễ
     hỏng, nên mỗi máy chỉ nhận đúng bộ của shell mình. */}}
{{- if ne .shell "noctalia" }}
.config/hypr/hyprland.lua
.config/hypr/noctalia.lua
.config/noctalia
.config/noctalia/**
# Nguồn để build lại gói noctalia đã vá lỗi pairing Bluetooth: chỉ có ý nghĩa
# trên máy chạy Noctalia.
.local/src/noctalia-bt-fix
.local/src/noctalia-bt-fix/**
{{- end }}
{{- if ne .shell "ariadnev" }}
.config/hypr/hyprland.conf
.config/hypr/workspaces.conf
.config/hypr/scripts
.config/hypr/scripts/**
.config/DankMaterialShell
.config/DankMaterialShell/**
# monitors-*.conf chỉ được `source` từ hyprland.conf; hyprland.lua khai monitor
# trực tiếp bằng hl.monitor() nên file này thừa trên máy Noctalia.
.config/hypr/monitors-*.conf
{{- end }}
